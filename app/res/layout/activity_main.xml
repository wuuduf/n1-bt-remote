<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101012"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minLines="2"
            android:text="正在初始化…"
            android:textColor="#FFB0B0B5"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/mac"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:hint="盒子蓝牙地址 AA:BB:CC:DD:EE:FF"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="17"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF6E6E73"
                android:textSize="15sp" />

            <Button
                android:id="@+id/pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="已配对" />

            <Button
                android:id="@+id/connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_body"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OTT"
                        android:textColor="#FFE6E6EA"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_power"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/btn_round"
                        android:contentDescription="盒子电源"
                        android:src="@drawable/ic_power"
                        android:tint="#FFE5484D" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:alpha="0.45"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TV"
                        android:textColor="#FFE6E6EA"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_tv"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/btn_round"
                        android:contentDescription="电视电源（不可用）"
                        android:src="@drawable/ic_power"
                        android:tint="#FFE6E6EA" />
                </LinearLayout>
            </RelativeLayout>

            <app.n1remote.DpadView
                android:id="@+id/dpad"
                android:layout_width="236dp"
                android:layout_height="236dp"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_round"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_back"
                    android:tint="#FFE6E6EA" />

                <ImageButton
                    android:id="@+id/btn_voice"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/btn_round"
                    android:contentDescription="语音"
                    android:src="@drawable/ic_mic"
                    android:tint="#FFF5A623" />

                <ImageButton
                    android:id="@+id/btn_vol_up"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_round"
                    android:contentDescription="音量加"
                    android:src="@drawable/ic_add"
                    android:tint="#FFE6E6EA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_home"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_round"
                    android:contentDescription="主页"
                    android:src="@drawable/ic_home"
                    android:tint="#FFE6E6EA" />

                <ImageButton
                    android:id="@+id/btn_menu"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/btn_round"
                    android:contentDescription="菜单"
                    android:src="@drawable/ic_menu"
                    android:tint="#FFE6E6EA" />

                <ImageButton
                    android:id="@+id/btn_vol_down"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_round"
                    android:contentDescription="音量减"
                    android:src="@drawable/ic_remove"
                    android:tint="#FFE6E6EA" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:letterSpacing="0.3"
                android:text="N1 REMOTE"
                android:textColor="#FF8E8E93"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/hint"
            android:textColor="#FF8E8E93"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
